# Ejemplo de entorno para Coralina v6. Copia a .env y ajusta.
# (En Next las vars se leen en runtime/build.)

# Postgres (Vercel Postgres/Neon o docker local):
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/coralina_v6
NEXT_PUBLIC_SITE_URL=http://localhost:3006

# Rate limit (in-memory por instancia). En Vercel es OBLIGATORIO TRUST_PROXY=1
# (la plataforma sobreescribe x-real-ip/x-forwarded-for):
# TRUST_PROXY=1
# RATE_LIMIT_MAX=30
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_ALLOW_LOCAL=1   # SOLO dev/QA: exime loopback aunque NODE_ENV=production

# Admin (produccion):
# CORALINA_ADMIN_PASSWORD=    # clave admin (reauth destructiva + firma de cookie)
# CORALINA_SESSION_SECRET=    # secreto HMAC para firmar la cookie coralina_role
# SESSION_UNSIGNED=1          # SOLO dev/QA: acepta la cookie de rol SIN firma
