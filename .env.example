# Copia este archivo a .env.local y completa los valores.
# .env.local nunca se commitea.

# Postgres (Neon en produccion). Usa la cadena con sslmode=require.
DATABASE_URL=

# URL publica del sitio. En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secreto de firma de sesiones. OBLIGATORIO en produccion.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CORALINA_SESSION_SECRET=

# Clave de reautenticacion para acciones destructivas (borrados duros, purgas).
CORALINA_ADMIN_PASSWORD=

# Solo desarrollo: permite sesiones sin CORALINA_SESSION_SECRET. Nunca en produccion.
CORALINA_ALLOW_UNSIGNED=

# Detras de proxy (Vercel): usar el header para resolver la IP del rate limit.
TRUST_PROXY=1

# Opcionales
PGPOOL_MAX=
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_ALLOW_LOCAL=
